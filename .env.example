POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL="postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@localhost:5432/{POSTGRES_DB}"

# Docker Compose constructs its own DATABASE_URL using the postgres service.
# These ports are optional; POSTGRES_PORT is only used by docker-compose.dev.yml.
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432

# Use a random value of at least 32 characters outside source control.
NUXT_SESSION_PASSWORD=

# Optional development seed password. Defaults to DriveHub123! when omitted.
SEED_DEFAULT_PASSWORD=
