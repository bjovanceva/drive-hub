# Copy to .env.production on the VM and fill in the image references and secrets.
# Publish runtime and tooling images from the same application version.
APP_IMAGE=your-dockerhub-user/drive-hub-app:1.0.0
TOOLING_IMAGE=your-dockerhub-user/drive-hub-tooling:1.0.0

POSTGRES_USER=drivehub
POSTGRES_PASSWORD=
POSTGRES_DB=drivehub

# Generate with: openssl rand -hex 32
# Keep this value stable across deployments to preserve existing sessions.
NUXT_SESSION_PASSWORD=

APP_PORT=3000
# Use 127.0.0.1 when an HTTPS reverse proxy runs directly on the same VM.
APP_BIND_ADDRESS=0.0.0.0
