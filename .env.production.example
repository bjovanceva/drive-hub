# Publish both Dockerfile targets from the same revision. No build happens on VM.
APP_IMAGE=your-dockerhub-user/drive-hub-app:1.0.1
TOOLING_IMAGE=your-dockerhub-user/drive-hub-tooling:1.0.1

POSTGRES_USER=drivehub
POSTGRES_PASSWORD=
POSTGRES_DB=drivehub
# Generate separate secrets: openssl rand -hex 32. Keep them stable on updates.
NUXT_SESSION_PASSWORD=

# Shared Nginx HTTP starter configuration. Replace with the real public domain.
# Include a port here only if the SHARED proxy serves the app on a custom port.
APP_ORIGIN=http://drivehub.example.com
# Temporary HTTP smoke tests require false. Set true when Nginx has HTTPS,
# and change APP_ORIGIN to https://... in the same deployment.
NUXT_SESSION_COOKIE_SECURE=false

# Comma-separated Nginx IPs/CIDRs. Prefer its stable address with /32 (/128 IPv6).
# Obtain these with docker inspect / docker network inspect; see docs/deployment.md.
# Trust a whole web-proxy subnet only when all containers on it are trusted.
TRUSTED_PROXY_CIDRS=
# No APP_PORT / POSTGRES_PORT: all services are private to Docker networks.
