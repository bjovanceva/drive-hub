// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  role              UserRole
  
  drivingSchool     DrivingSchool @relation(fields: [drivingSchoolId], references: [id])
  drivingSchoolId   Int

  applications      Application[]
}

model DrivingSchool {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  description  String?
  phone        String
  address      String
  createdAt    DateTime

  users        User[]
  categories   Category[]
  applications Application[]
  vehicles     Vehicle[]
}

model Category {
  id                 Int        @id @default(autoincrement())
  name               String     @unique
  price              Decimal
  theoryLessons      Int
  practicalLessons   Int
  minimumAge         Int

  drivingSchools DrivingSchool[]
  applications Application[]
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  brand            String
  model           String
  year            Int
  registration    String        @unique

  drivingSchool   DrivingSchool @relation(fields: [drivingSchoolId], references: [id])
  drivingSchoolId Int
}

model Application {
  id              Int           @id @default(autoincrement())
  status          ApplicationStatus  @default(PENDING)
  startedAt       DateTime           @default(now())

  userId          Int
  drivingSchoolId Int
  categoryId      Int

  user            User              @relation(fields: [userId], references: [id])
  drivingSchool   DrivingSchool     @relation(fields: [drivingSchoolId], references: [id])
  category        Category          @relation(fields: [categoryId], references: [id])

  @@unique([userId, drivingSchoolId, categoryId])
}

